//@version=6
// M3 DEGER BANDI v2 (6 Kasim 2026) - Zippo'nun sade "IKARUS" tablosuna en yakin surum (birebir DEGIL).
// Hesap grafigin zaman diliminden ve adj dugmesinden bagimsiz: her zaman AYLIK, bolunme duzeltmeli + temettusuz veri.
//   adjC        = aylik fiyat / M3 (ECONOMICS:TRM3, ayni ay)
//   Ucuzluk     = tum gecmisin en dusuk (aylik kapanis / M3) x guncel M3
//   Pahali      = son 48 ayin en yuksek (aylik en yuksek / M3) x guncel M3
//   Adil        = (Pahali + Ucuzluk) / 2            (Zippo ile birebir)
//   Ucuz<->Pahali = (fiyat - Ucuzluk) / (Pahali - Ucuzluk) x 100   (Zippo ile birebir)
//   Fiyat       = aylik Heikin Ashi kapanisi = ayin (acilis+yuksek+dusuk+kapanis)/4   (Zippo ile birebir)
// Zippo tablolariyla fark (TradingView verisi 6 Kas): EREGL 3 Kas Ucuzluk 29.03 (Z 29.02), Pahali 99.43 (Z 99.00);
//   SISE 5 Kas Ucuzluk 31.09 (Z 31.72, -%2), Pahali 184.71 (Z 189.64, -%2.6).
//   Fark kismen TradingView'in 6 Kas'ta M3 gecmisini degistirmesinden olabilir. Kademe esikleri TAHMIN.
// v1'deki 800 TL hatasi: adjustment.none bolunme duzeltmesini de kapatiyordu (SISE eski fiyatlari kat kat yuksek).
indicator("M3 Deger Bandi v2", shorttitle = "M3 Bant v2", overlay = true)

grpD = "Degerleme"
fiyatMod = input.string("Bolunme duzeltmeli, temettusuz (Zippo)", "Fiyat verisi", options = ["Bolunme duzeltmeli, temettusuz (Zippo)", "Temettu duzeltmeli"], group = grpD)
ucuzMod  = input.string("Tum gecmis", "Ucuzluk penceresi", options = ["Tum gecmis", "N ay"], group = grpD)
ucuzN    = input.int(240, "Ucuzluk N ay", minval = 12, maxval = 400, group = grpD)
ucuzSrc  = input.string("Kapanis", "Ucuzluk kaynagi", options = ["Kapanis", "Fitil (en dusuk)"], group = grpD)
pahaliN  = input.int(48, "Pahali penceresi (ay)", minval = 12, maxval = 400, group = grpD)
pahaliSrc = input.string("Fitil (en yuksek)", "Pahali kaynagi", options = ["Fitil (en yuksek)", "Kapanis"], group = grpD)

grpK = "Kademe (tahmin)"
al3  = input.float(10, "AL 3/3 esigi (<=)", group = grpK)
al2  = input.float(20, "AL 2/3 esigi (<=)", group = grpK)
al1  = input.float(33, "AL 1/3 esigi (<=)", group = grpK)
sat1 = input.float(67, "SAT 1/3 esigi (>=)", group = grpK)
sat2 = input.float(80, "SAT 2/3 esigi (>=)", group = grpK)
sat3 = input.float(90, "SAT 3/3 esigi (>=)", group = grpK)
konum = input.string("Sag ust", "Tablo yeri", options = ["Sag ust", "Sag alt", "Sol ust", "Sol alt"])

tk = ticker.modify(syminfo.tickerid, adjustment = fiyatMod == "Temettu duzeltmeli" ? adjustment.dividends : adjustment.splits)

// Aylik barlarda hesaplanir. M3 ayni ayin degeri (aylik grafikte TradingView boyle hizalar).
aylik() =>
    m3 = request.security("ECONOMICS:TRM3", "1M", close, ignore_invalid_symbol = true) / 1e12
    lo = ucuzSrc == "Kapanis" ? close : low
    hi = pahaliSrc == "Kapanis" ? close : high
    aLo = m3 > 0 ? lo / m3 : na
    aHi = m3 > 0 ? hi / m3 : na
    var float mnAll = na
    if not na(aLo)
        mnAll := na(mnAll) ? aLo : math.min(mnAll, aLo)
    mn = ucuzMod == "Tum gecmis" ? mnAll : ta.lowest(aLo, ucuzN)
    mx = ta.highest(aHi, pahaliN)
    [mn * m3, mx * m3, ohlc4, m3]

[ucuz, pahali, pxHA, m3] = request.security(tk, "1M", aylik())
adil = (ucuz + pahali) / 2
puan = pahali > ucuz ? 100 * (pxHA - ucuz) / (pahali - ucuz) : na

bolge  = puan <= 33 ? "UCUZ (DESTEK)" : puan >= 67 ? "PAHALI (DIRENC)" : "ADIL (ORTA)"
kademe = puan <= al3 ? "AL 3 / 3" : puan <= al2 ? "AL 2 / 3" : puan <= al1 ? "AL 1 / 3" : puan >= sat3 ? "SAT 3 / 3" : puan >= sat2 ? "SAT 2 / 3" : puan >= sat1 ? "SAT 1 / 3" : "BEKLE"

plot(pahali, "Pahali (Direnc)", color.new(color.red, 0), 2)
plot(adil, "Adil Deger", color.new(color.gray, 0), 1)
plot(ucuz, "Ucuzluk (Destek)", color.new(color.teal, 0), 2)
plot(puan, "Ucuz-Pahali", display = display.data_window)
plot(pxHA, "Tablo fiyati (aylik HA)", display = display.data_window)
plot(m3, "M3 (trilyon)", display = display.data_window)

fmt(x) => str.tostring(x, "#.00") + " TL (" + (x >= pxHA ? "+" : "") + str.tostring(100 * (x / pxHA - 1), "#") + "%)"
pos = konum == "Sag ust" ? position.top_right : konum == "Sag alt" ? position.bottom_right : konum == "Sol ust" ? position.top_left : position.bottom_left
var table T = table.new(pos, 2, 9, border_width = 1)
if barstate.islast
    cB = color.new(#2a3550, 0)
    cG = color.new(#26a69a, 0)
    cR = color.new(#f77c80, 0)
    cA = color.new(#b2b5be, 0)
    cBol = puan <= 33 ? cG : puan >= 67 ? cR : cA
    table.cell(T, 0, 0, "M3 DEGER BANDI v2", text_color = color.white, bgcolor = color.gray)
    table.merge_cells(T, 0, 0, 1, 0)
    table.cell(T, 0, 1, "Ucuz <-> Pahali (0-100)", text_color = color.white, bgcolor = cB)
    table.cell(T, 1, 1, str.tostring(puan, "#.0") + " / 100", text_color = color.white, bgcolor = cB)
    table.cell(T, 0, 2, "Bolge Durumu", text_color = color.white, bgcolor = cBol)
    table.cell(T, 1, 2, bolge, text_color = color.white, bgcolor = cBol)
    table.cell(T, 0, 3, "GUNCEL FIYAT HEDEFLERI", text_color = color.white, bgcolor = color.new(#131a2e, 0))
    table.merge_cells(T, 0, 3, 1, 3)
    table.cell(T, 0, 4, "Pahali Seviyesi (Direnc)", text_color = color.white, bgcolor = cR)
    table.cell(T, 1, 4, fmt(pahali), text_color = color.white, bgcolor = cR)
    table.cell(T, 0, 5, "Adil Deger (Orta Hat)", text_color = color.white, bgcolor = cA)
    table.cell(T, 1, 5, fmt(adil), text_color = color.white, bgcolor = cA)
    table.cell(T, 0, 6, "Ucuzluk Seviyesi (Destek)", text_color = color.white, bgcolor = cG)
    table.cell(T, 1, 6, fmt(ucuz), text_color = color.white, bgcolor = cG)
    table.cell(T, 0, 7, "Kademe", text_color = color.white, bgcolor = cBol)
    table.cell(T, 1, 7, kademe, text_color = color.white, bgcolor = cBol)
    table.cell(T, 0, 8, "Aylik veri, bolunme duzeltmeli/temettusuz, fiyat aylik HA. Her zaman diliminde ayni sonuc.", text_color = color.white, bgcolor = color.new(#131a2e, 0), text_size = size.tiny)
    table.merge_cells(T, 0, 8, 1, 8)
