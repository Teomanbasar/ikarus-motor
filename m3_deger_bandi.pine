//@version=5
// M3 DEGER BANDI (deneme) - 4 Kasim 2026. Zippo'nun sade "IKARUS" tablosunun taklidi (ornek: EREGL, 3 Kas 17:35 paylasimi).
// ONEMLI: Zippo bu tabloyu TEMETTU DUZELTMESI KAPALI ("adj" kapali) grafikte almis. TradingView verisiyle EREGL Ucuzluk
//   29.0214 -> 29.02 birebir (o gunku M3 = Eylul degeri). Duzeltmeliyle tum gecmisin dibi 2009'a kayiyor.
//   Bu surum duzeltmesiz fiyati KENDISI ceker (ayar: "Fiyat verisi"), grafikteki adj dugmesi ne olursa olsun ayni sonucu verir.
//   (Ana IKARUS CORE ise duzeltme ACIK calisir; onu degistirme.)
// COZULEN (EREGL ile):
//   Ucuzluk (Destek) = tum gecmisin en dusuk (kapanis / M3) degeri x guncel M3   (EREGL'de 1 yildan uzun her pencere ayni)
//   Adil Deger       = (Pahali + Ucuzluk) / 2                  -> 64.01 birebir
//   Ucuz<->Pahali    = (fiyat - Ucuzluk) / (Pahali - Ucuzluk) x 100   (dogrusal konum, percentrank DEGIL) -> 1.9 birebir
// COZULMEYEN: Pahali (Direnc) 99.00. Ayni seride tum gecmis tepe 117.46 (16 Ara 2021); hicbir kayan pencere 99 vermiyor
//   (97.45 -> 101.74 atliyor). Yuzdelik, ortalama+sapma, Heikin Ashi, en yuksek, haftalik/aylik denendi: dogal bir eslesme yok.
//   Ayarlardan yontem secilebilir; yeni Zippo ornekleriyle netlesecek. Varsayilan "Tum gecmis" EREGL'de 117 civari gosterir.
// Kademe esikleri TAHMIN (tek ornek: 1.9 -> AL 3/3). Ayarlardan degistirilebilir.
indicator("M3 Deger Bandi", shorttitle = "M3 Bant", overlay = true, max_bars_back = 5000)

grpD = "Degerleme"
dipMod  = input.string("Tum gecmis", "Ucuzluk penceresi", options = ["Tum gecmis", "N bar"], group = grpD)
dipN    = input.int(1000, "Ucuzluk N bar", minval = 50, maxval = 5000, group = grpD)
tepeMod = input.string("Tum gecmis", "Pahali yontemi (COZULMEDI)", options = ["Tum gecmis", "N bar"], group = grpD)
tepeN   = input.int(1000, "Pahali N bar", minval = 50, maxval = 5000, group = grpD)

grpK = "Kademe (tahmin)"
al3 = input.float(10, "AL 3/3 esigi (<=)", group = grpK)
al2 = input.float(20, "AL 2/3 esigi (<=)", group = grpK)
al1 = input.float(33, "AL 1/3 esigi (<=)", group = grpK)
sat1 = input.float(67, "SAT 1/3 esigi (>=)", group = grpK)
sat2 = input.float(80, "SAT 2/3 esigi (>=)", group = grpK)
sat3 = input.float(90, "SAT 3/3 esigi (>=)", group = grpK)
konum = input.string("Sag ust", "Tablo yeri", options = ["Sag ust", "Sag alt", "Sol ust", "Sol alt"])

fiyatMod = input.string("Temettu duzeltmesiz (Zippo)", "Fiyat verisi", options = ["Temettu duzeltmesiz (Zippo)", "Grafikteki gibi"])
ham  = request.security(ticker.modify(syminfo.tickerid, adjustment = adjustment.none), timeframe.period, close)
src  = fiyatMod == "Grafikteki gibi" ? close : nz(ham, close)
// M3: ana IKARUS ile ayni okuma (ay kapaninca devreye girer)
m3   = request.security("ECONOMICS:TRM3", timeframe.period, close, ignore_invalid_symbol = true) / 1e12
adjC = m3 > 0 ? src / m3 : na
// Tablodaki fiyat: Zippo aylik Heikin Ashi grafikte calisiyor -> fiyat = ayin (acilis+yuksek+dusuk+kapanis)/4
// (SISE 5 Kas: 33.885 -> +460/+227/-6% birebir; EREGL 3 Kas da tutuyor). Seviyeler ise GUNLUK grafikte hesaplanmali.
pxMod  = input.string("Aylik Heikin Ashi (Zippo)", "Tablo fiyati", options = ["Aylik Heikin Ashi (Zippo)", "Son kapanis"])
pxHA   = request.security(ticker.modify(syminfo.tickerid, adjustment = adjustment.none), "1M", ohlc4, lookahead = barmerge.lookahead_off)
pxNow  = pxMod == "Son kapanis" ? src : nz(pxHA, src)

var float minAll = na
var float maxAll = na
if not na(adjC)
    minAll := na(minAll) ? adjC : math.min(minAll, adjC)
    maxAll := na(maxAll) ? adjC : math.max(maxAll, adjC)

loN   = ta.lowest(adjC, dipN)
hiN   = ta.highest(adjC, tepeN)
dipA  = dipMod  == "Tum gecmis" ? minAll : loN
tepeA = tepeMod == "Tum gecmis" ? maxAll : hiN
ucuz  = dipA * m3
pahali = tepeA * m3
adil  = (ucuz + pahali) / 2
puan  = pahali > ucuz ? 100 * (pxNow - ucuz) / (pahali - ucuz) : na

bolge = puan <= 33 ? "UCUZ (DESTEK)" : puan >= 67 ? "PAHALI (DIRENC)" : "ADIL (ORTA)"
kademe = puan <= al3 ? "AL 3 / 3" : puan <= al2 ? "AL 2 / 3" : puan <= al1 ? "AL 1 / 3" :
         puan >= sat3 ? "SAT 3 / 3" : puan >= sat2 ? "SAT 2 / 3" : puan >= sat1 ? "SAT 1 / 3" : "BEKLE"

plot(pahali, "Pahali (Direnc)", color.new(color.red, 0), 2)
plot(adil, "Adil Deger", color.new(color.gray, 0), 1)
plot(ucuz, "Ucuzluk (Destek)", color.new(color.teal, 0), 2)
plot(puan, "Ucuz-Pahali", display = display.data_window)

pct(x) => str.tostring(x, "#.00") + " TL (" + (x >= pxNow ? "+" : "") + str.tostring(100 * (x / pxNow - 1), "#") + "%)"
pos = konum == "Sag ust" ? position.top_right : konum == "Sag alt" ? position.bottom_right : konum == "Sol ust" ? position.top_left : position.bottom_left
var table T = table.new(pos, 2, 9, border_width = 1)
if barstate.islast
    cB = color.new(#2a3550, 0)
    cG = color.new(#26a69a, 0)
    cR = color.new(#f77c80, 0)
    cA = color.new(#b2b5be, 0)
    cBol = puan <= 33 ? cG : puan >= 67 ? cR : cA
    table.cell(T, 0, 0, "M3 DEGER BANDI", text_color = color.white, bgcolor = color.gray)
    table.merge_cells(T, 0, 0, 1, 0)
    table.cell(T, 0, 1, "Ucuz <-> Pahali (0-100)", text_color = color.white, bgcolor = cB)
    table.cell(T, 1, 1, str.tostring(puan, "#.0") + " / 100", text_color = color.white, bgcolor = cB)
    table.cell(T, 0, 2, "Bolge Durumu", text_color = color.white, bgcolor = cBol)
    table.cell(T, 1, 2, bolge, text_color = color.white, bgcolor = cBol)
    table.cell(T, 0, 3, "GUNCEL FIYAT HEDEFLERI", text_color = color.white, bgcolor = color.new(#131a2e, 0))
    table.merge_cells(T, 0, 3, 1, 3)
    table.cell(T, 0, 4, "Pahali Seviyesi (Direnc)", text_color = color.white, bgcolor = cR)
    table.cell(T, 1, 4, pct(pahali), text_color = color.white, bgcolor = cR)
    table.cell(T, 0, 5, "Adil Deger (Orta Hat)", text_color = color.white, bgcolor = cA)
    table.cell(T, 1, 5, pct(adil), text_color = color.white, bgcolor = cA)
    table.cell(T, 0, 6, "Ucuzluk Seviyesi (Destek)", text_color = color.white, bgcolor = cG)
    table.cell(T, 1, 6, pct(ucuz), text_color = color.white, bgcolor = cG)
    table.cell(T, 0, 7, "Kademe", text_color = color.white, bgcolor = cBol)
    table.cell(T, 1, 7, kademe, text_color = color.white, bgcolor = cBol)
    notTxt = not timeframe.isdaily ? "UYARI: GUNLUK grafikte kullan (seviyeler gunluk veriden)" : fiyatMod == "Grafikteki gibi" ? "Not: grafikte 'adj' (temettu duzeltmesi) KAPALI olmali" : "Fiyat: temettu duzeltmesiz veri, tablo fiyati aylik HA"
    table.cell(T, 0, 8, notTxt, text_color = color.white, bgcolor = not timeframe.isdaily ? color.new(#b71c1c, 0) : color.new(#131a2e, 0), text_size = size.tiny)
    table.merge_cells(T, 0, 8, 1, 8)
